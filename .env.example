# ==============================================================================
# BAUTO RESORT WEAR - VARIABLES DE ENTORNO PARA PRODUCCIÓN (VERCEL)
# ==============================================================================
# Configurar estas variables en el panel de Vercel (Project Settings > Environment Variables)
# o en tu archivo .env.local para pruebas locales.

# 1. URL Canónica del Sitio
NEXT_PUBLIC_SITE_URL="https://www.bauto.com.co"

# 2. Pasarela de Pagos Wompi (Bancolombia) - Costo Fijo $0 COP
# Obtenerlas en https://comercios.wompi.co > Desarrolladores > Llaves de API
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_..." # O pub_prod_... en producción
WOMPI_INTEGRITY_SECRET="test_integrity_..." # Secreto para cálculo SHA-256 de precios
WOMPI_EVENTS_SECRET="test_events_..."       # Secreto para validación SHA-256 de webhooks
WOMPI_PRIVATE_KEY="prv_test_..."            # Usada exclusivamente por el cron de conciliación

# 3. Upstash Redis (Vercel KV) - Two-Phase Soft Lock (12 min) - Capa Gratuita ($0)
# Obtenerlas en https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://tu-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu_token_upstash_aqui"

# 4. Motor de Correos Transaccionales (Resend) - Tier Gratuito 3.000 emails/mes ($0)
# Obtenerla en https://resend.com/api-keys
RESEND_API_KEY="re_tu_api_key_aqui"
EMAIL_FROM="BAUTO Resort Wear <pedidos@bauto.com.co>"

# 5. Puente con Google Apps Script (2. APPBAUTO) - Token M2M
# Mismo secreto configurado en PropertiesService de 2. APPBAUTO (SECRETO_VENTA_SERVICIO)
SECRETO_VENTA_SERVICIO="tu_secreto_compartido_aqui"

# 6. Logística y Rastreo (MiPaquete API V2)
# Obtenerla en tu cuenta de MiPaquete (o dejar vacía para simulación automática)
MIPAQUETE_API_KEY=""

# 7. Google Cloud Platform (Google Places API Autocomplete) - Crédito $200 USD/mes ($0)
# Restringida por HTTP referrer a https://www.bauto.com.co
GOOGLE_MAPS_API_KEY=""

# 8. Vercel Cron Secret (Protección del endpoint /api/cron/reconcile)
# Generar un hash aleatorio seguro (ej: openssl rand -hex 32)
CRON_SECRET="bauto_cron_secret_random_token_32chars"
